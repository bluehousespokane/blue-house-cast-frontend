<!DOCTYPE html>
<html>
  <head>
    <style>
      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        overflow: hidden;
        background: #000;
        color-scheme: dark;
      }

      body {
        font-size: initial;
      }

      #cast-loading-screen {
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: #000;
        opacity: 1;
      }

      #cast-loading-screen[hidden] {
        display: none;
      }

      #cast-loading-particles {
        position: absolute;
        inset: 10%;
        width: 80%;
        height: 80%;
        opacity: 0.3;
        touch-action: none;
      }
    </style>
    <%= renderTemplate("../../../src/html/_style_base.html.template") %>
  </head>
  <body>
    <div
      id="cast-loading-screen"
      role="status"
      aria-label="Loading Home Assistant"
    >
      <canvas id="cast-loading-particles" aria-hidden="true"></canvas>
    </div>
    <script>
      (() => {
        const loader = document.getElementById("cast-loading-screen");
        const canvas = document.getElementById("cast-loading-particles");
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        if (!loader) {
          return;
        }

        const listeners = new Set();
        let animationFrame = 0;
        let revealTimer = 0;
        let transitionGeneration = 0;
        let transitionFrame = 0;
        let finishTransition;
        let openness = 0;
        let visible = true;
        let held = false;
        let startParticleAnimation = () => {};
        let width = 0;
        let height = 0;
        let lastFrame = 0;
        let particles = [];
        let pointer;

        const notifyVisibility = () => {
          listeners.forEach((listener) => listener(visible));
        };

        // Mask the whole layer so its particles leave with the black cover.
        const applyMask = () => {
          if (openness === 0) {
            loader.style.maskImage = "none";
            loader.style.webkitMaskImage = "none";
            return;
          }
          const feather = innerWidth * 0.75;
          const radius =
            openness * (Math.hypot(innerWidth / 2, innerHeight / 2) + feather);
          const inner = radius - feather;
          const start = Math.max(0, -inner / feather);
          const stops = Array.from({ length: 49 }, (_, index) => {
            const t = start + ((1 - start) * index) / 48;
            const alpha = t * t * t * (t * (t * 6 - 15) + 10);
            const px = Math.max(0, inner + t * feather);
            return (
              "rgba(0,0,0," + alpha.toFixed(6) + ") " + px.toFixed(2) + "px"
            );
          });
          const mask =
            "radial-gradient(circle at center, " + stops.join(",") + ")";
          loader.style.maskImage = mask;
          loader.style.webkitMaskImage = mask;
        };

        const transitionTo = (target, duration) => {
          if (openness === target && !finishTransition) {
            return Promise.resolve(true);
          }
          const generation = ++transitionGeneration;
          window.cancelAnimationFrame(transitionFrame);
          finishTransition?.(false);
          const from = openness;
          loader.hidden = false;
          visible = true;
          notifyVisibility();
          if (!reducedMotion && !animationFrame) {
            animationFrame = window.requestAnimationFrame(
              startParticleAnimation
            );
          }

          return new Promise((resolve) => {
            const finish = (completed) => {
              if (generation === transitionGeneration) {
                finishTransition = undefined;
              }
              resolve(completed);
            };
            finishTransition = finish;
            const started = performance.now();
            const frame = (now) => {
              if (generation !== transitionGeneration) return;
              const t = reducedMotion
                ? 1
                : Math.min((now - started) / Math.max(1, duration), 1);
              openness = from + (target - from) * (1 - (1 - t) ** 3);
              applyMask();
              if (t < 1) {
                transitionFrame = window.requestAnimationFrame(frame);
                return;
              }
              visible = target === 0;
              loader.hidden = !visible;
              notifyVisibility();
              finish(true);
            };
            if (reducedMotion || from === target) frame(started + duration);
            else transitionFrame = window.requestAnimationFrame(frame);
          });
        };

        const show = (hold = true) => {
          held = hold;
          window.clearTimeout(revealTimer);
          return transitionTo(0, 650);
        };

        const hide = () => {
          held = false;
          window.clearTimeout(revealTimer);
          return transitionTo(1, 5000);
        };

        const scheduleReveal = () => {
          if (held || !visible) {
            return;
          }
          window.clearTimeout(revealTimer);
          revealTimer = window.setTimeout(() => void hide(), 2000);
        };

        window.blueHouseCastLoadingScreen = {
          show,
          hide,
          scheduleReveal,
          subscribe(listener) {
            listeners.add(listener);
            listener(visible);
            return () => listeners.delete(listener);
          },
        };
        window.addEventListener("cast-loading-ready", scheduleReveal);
        window.addEventListener("cast-loading-error", () => void hide());

        const context = canvas?.getContext("2d");
        if (!canvas || !context) {
          return;
        }

        const resizeParticles = () => {
          const nextWidth = window.innerWidth * 0.8;
          const nextHeight = window.innerHeight * 0.8;
          const scale = Math.min(window.devicePixelRatio || 1, 1.25);

          particles.forEach((particle) => {
            particle.x *= width ? nextWidth / width : 1;
            particle.y *= height ? nextHeight / height : 1;
          });
          width = nextWidth;
          height = nextHeight;
          canvas.width = Math.round(width * scale);
          canvas.height = Math.round(height * scale);
          context.setTransform(scale, 0, 0, scale, 0, 0);
          if (particles.length) {
            createParticleField();
            lastFrame = 0;
            drawParticles(performance.now());
          }
        };

        const createParticles = (count, color, settings) =>
          Array.from({ length: count }, () => {
            return {
              x: Math.random() * width,
              y: Math.random() * height,
              vx: Math.random() - 0.5,
              vy: Math.random() - 0.5,
              color,
              radius:
                settings.minRadius +
                Math.random() * (settings.maxRadius - settings.minRadius),
              alpha: settings.animateOpacity ? 0.5 : Math.random() * 0.5,
              sizeStep: Math.random() * 0.1,
              opacityStep: Math.random() * 0.01,
              sizeDirection: -1,
              opacityDirection: -1,
              settings,
            };
          });

        const createParticleField = () => {
          const units = Math.max(
            10,
            Math.min(70, Math.round((width * height * 35) / 800000))
          );
          particles = [
            ...createParticles(units * 6, "#E8EEF4", {
              minRadius: 0.1,
              maxRadius: 15,
              animateSize: true,
              attract: true,
            }),
            ...createParticles(units * 3, "#005E88", {
              minRadius: 0.1,
              maxRadius: 10,
              animateOpacity: true,
              attract: false,
            }),
            ...createParticles(units, "#F58220", {
              minRadius: 0.1,
              maxRadius: 15,
              animateSize: true,
              attract: true,
            }),
          ];
        };

        const drawParticles = (timestamp) => {
          if (!lastFrame || timestamp - lastFrame >= 40) {
            const frameScale = lastFrame
              ? Math.min((timestamp - lastFrame) / (1000 / 60), 6)
              : 0;
            lastFrame = timestamp;

            if (!reducedMotion && frameScale) {
              particles.forEach((particle) => {
                particle.x += particle.vx * 0.25 * frameScale;
                particle.y += particle.vy * 0.25 * frameScale;
                if (particle.settings.animateSize) {
                  particle.radius +=
                    particle.sizeDirection * particle.sizeStep * frameScale;
                  if (particle.radius >= particle.settings.maxRadius)
                    particle.sizeDirection = -1;
                  if (particle.radius <= 0.1) particle.sizeDirection = 1;
                  particle.radius = Math.max(
                    0.1,
                    Math.min(particle.settings.maxRadius, particle.radius)
                  );
                }
                if (particle.settings.animateOpacity) {
                  particle.alpha +=
                    particle.opacityDirection *
                    particle.opacityStep *
                    frameScale;
                  if (particle.alpha >= 0.5) particle.opacityDirection = -1;
                  if (particle.alpha <= 0.1) particle.opacityDirection = 1;
                  particle.alpha = Math.max(0.1, Math.min(0.5, particle.alpha));
                }
                if (
                  particle.x < particle.radius ||
                  particle.x > width - particle.radius
                ) {
                  particle.vx *= -1;
                  particle.x = Math.max(
                    particle.radius,
                    Math.min(width - particle.radius, particle.x)
                  );
                }
                if (
                  particle.y < particle.radius ||
                  particle.y > height - particle.radius
                ) {
                  particle.vy *= -1;
                  particle.y = Math.max(
                    particle.radius,
                    Math.min(height - particle.radius, particle.y)
                  );
                }
              });

              const attracting = particles.filter(
                (particle) => particle.settings.attract
              );
              for (let index = 0; index < attracting.length; index += 1) {
                const particle = attracting[index];
                for (
                  let otherIndex = index + 1;
                  otherIndex < attracting.length;
                  otherIndex += 1
                ) {
                  const other = attracting[otherIndex];
                  if (other.color !== particle.color) continue;
                  const dx = other.x - particle.x;
                  const dy = other.y - particle.y;
                  const distanceSquared = dx * dx + dy * dy;
                  if (distanceSquared > 0 && distanceSquared <= 22500) {
                    const ax = (dx * frameScale) / (3946 * 1000);
                    const ay = (dy * frameScale) / (158 * 1000);
                    particle.vx += ax;
                    particle.vy += ay;
                    other.vx -= ax;
                    other.vy -= ay;
                  }
                }
              }
            }

            context.clearRect(0, 0, width, height);
            particles.forEach((particle) => {
              context.globalAlpha = particle.alpha;
              context.fillStyle = particle.color;
              context.beginPath();
              context.arc(
                particle.x,
                particle.y,
                particle.radius,
                0,
                Math.PI * 2
              );
              context.fill();
            });

            context.globalAlpha = 1;
            if (pointer) {
              particles.forEach((particle) => {
                if (particle.color !== "#005E88") {
                  return;
                }
                const dx = pointer.x - particle.x;
                const dy = pointer.y - particle.y;
                const distance = Math.sqrt(dx * dx + dy * dy);
                if (distance < 200) {
                  context.strokeStyle =
                    "rgba(255, 255, 255, " + 0.2 * (1 - distance / 200) + ")";
                  context.lineWidth = 1;
                  context.beginPath();
                  context.moveTo(particle.x, particle.y);
                  context.lineTo(pointer.x, pointer.y);
                  context.stroke();
                }
              });
            }
            context.globalAlpha = 1;
          }
        };

        const animateParticles = (timestamp) => {
          animationFrame = 0;
          drawParticles(timestamp);
          if (!reducedMotion && visible) {
            animationFrame = window.requestAnimationFrame(animateParticles);
          }
        };

        startParticleAnimation = animateParticles;
        resizeParticles();
        createParticleField();
        canvas.addEventListener("pointermove", (event) => {
          const bounds = canvas.getBoundingClientRect();
          pointer = {
            x: event.clientX - bounds.left,
            y: event.clientY - bounds.top,
          };
        });
        canvas.addEventListener("pointerleave", () => {
          pointer = undefined;
        });
        drawParticles(performance.now());
        if (!reducedMotion) {
          animationFrame = window.requestAnimationFrame(animateParticles);
        }
        window.addEventListener("resize", resizeParticles, { passive: true });
      })();
    </script>
    <script src="//www.gstatic.com/cast/sdk/libs/caf_receiver/v3/cast_receiver_framework.js"></script>
    <% for (const entry of latestEntryJS) { %>
    <script type="module" src="<%= entry %>"></script>
    <% } %>
  </body>
</html>
