<!DOCTYPE html>
<html>
  <head>
    <style>
      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        overflow: hidden;
        background: #000;
        color-scheme: dark;
      }

      body {
        font-size: initial;
      }

      #cast-loading-screen {
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: #000;
        opacity: 1;
        transition: opacity 650ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      #cast-loading-screen[hidden] {
        display: none;
      }

      #cast-loading-screen.cast-loading-screen--leaving {
        opacity: 0;
        pointer-events: none;
      }

      #cast-loading-particles {
        position: absolute;
        inset: 10%;
        width: 80%;
        height: 80%;
        opacity: 0.7;
        pointer-events: none;
      }
    </style>
    <%= renderTemplate("../../../src/html/_style_base.html.template") %>
  </head>
  <body>
    <div
      id="cast-loading-screen"
      role="status"
      aria-label="Loading Home Assistant"
    >
      <canvas id="cast-loading-particles" aria-hidden="true"></canvas>
    </div>
    <script>
      (() => {
        const loader = document.getElementById("cast-loading-screen");
        const canvas = document.getElementById("cast-loading-particles");
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        let animationFrame = 0;
        let revealTimer = 0;
        let dismissTimer = 0;
        let finished = false;
        let resizeParticles = () => {};

        const stopParticles = () => {
          if (animationFrame) {
            window.cancelAnimationFrame(animationFrame);
          }
          window.removeEventListener("resize", resizeParticles);
        };

        const hideLoader = () => {
          if (!loader) {
            return;
          }
          finished = true;
          window.clearTimeout(revealTimer);
          window.clearTimeout(dismissTimer);
          loader.hidden = true;
          stopParticles();
        };

        const finishLoading = (animate) => {
          if (!loader || finished) {
            return;
          }
          finished = true;
          window.clearTimeout(revealTimer);
          if (!animate || reducedMotion) {
            hideLoader();
            return;
          }
          loader.classList.add("cast-loading-screen--leaving");
          dismissTimer = window.setTimeout(hideLoader, 700);
        };

        const scheduleReveal = () => {
          if (!revealTimer) {
            revealTimer = window.setTimeout(
              () => finishLoading(true),
              2000
            );
          }
        };
        window.addEventListener("cast-view-changed", scheduleReveal, {
          once: true,
        });
        window.addEventListener("cast-loading-ready", scheduleReveal, {
          once: true,
        });
        document.addEventListener(
          "cast-loading-error",
          () => {
            hideLoader();
          },
          { once: true }
        );

        if (!canvas) {
          return;
        }

        const context = canvas.getContext("2d");
        if (!context) {
          return;
        }

        let width = 0;
        let height = 0;
        let lastFrame = 0;
        let particles = [];

        resizeParticles = () => {
          const nextWidth = window.innerWidth * 0.8;
          const nextHeight = window.innerHeight * 0.8;
          const scale = Math.min(window.devicePixelRatio || 1, 1.25);

          particles.forEach((particle) => {
            particle.x *= width ? nextWidth / width : 1;
            particle.y *= height ? nextHeight / height : 1;
          });
          width = nextWidth;
          height = nextHeight;
          canvas.width = Math.round(width * scale);
          canvas.height = Math.round(height * scale);
          context.setTransform(scale, 0, 0, scale, 0, 0);
          if (reducedMotion && particles.length) {
            drawParticles(performance.now());
          }
        };

        const startParticles = () => {
          if (finished) {
            return;
          }

          const colors = [
            ...Array(60).fill("#E8EEF4"),
            ...Array(30).fill("#005E88"),
            ...Array(10).fill("#F58220"),
          ];
          for (let index = colors.length - 1; index > 0; index -= 1) {
            const swap = Math.floor(Math.random() * (index + 1));
            [colors[index], colors[swap]] = [colors[swap], colors[index]];
          }

          resizeParticles();
          particles = colors.map((color) => ({
            x: Math.random() * width,
            y: Math.random() * height,
            dx: (Math.random() - 0.5) * 12,
            dy: (Math.random() - 0.5) * 12,
            radius: 0.9 + Math.random() * 1.4,
            alpha: 0.6 + Math.random() * 0.4,
            color,
          }));
          window.addEventListener("resize", resizeParticles, {
            passive: true,
          });
          drawParticles(performance.now());
        };

        const drawParticles = (timestamp) => {
          if (finished) {
            return;
          }
          if (!lastFrame || timestamp - lastFrame >= 40) {
            const elapsed = lastFrame
              ? Math.min((timestamp - lastFrame) / 1000, 0.1)
              : 0;
            lastFrame = timestamp;
            context.clearRect(0, 0, width, height);
            particles.forEach((particle) => {
              particle.x += particle.dx * elapsed;
              particle.y += particle.dy * elapsed;
              if (particle.x < 0) particle.x += width;
              if (particle.x > width) particle.x -= width;
              if (particle.y < 0) particle.y += height;
              if (particle.y > height) particle.y -= height;
              context.globalAlpha = particle.alpha;
              context.fillStyle = particle.color;
              context.beginPath();
              context.arc(
                particle.x,
                particle.y,
                particle.radius,
                0,
                Math.PI * 2
              );
              context.fill();
            });
            context.globalAlpha = 1;
          }
          if (!reducedMotion) {
            animationFrame = window.requestAnimationFrame(drawParticles);
          }
        };

        startParticles();
      })();
    </script>
    <script src="//www.gstatic.com/cast/sdk/libs/caf_receiver/v3/cast_receiver_framework.js"></script>
    <% for (const entry of latestEntryJS) { %>
      <script type="module" src="<%= entry %>"></script>
    <% } %>
  </body>
</html>
