<!DOCTYPE html>
<html>
  <head>
    <style>
      html,
      body {
        width: 100%;
        height: 100%;
        margin: 0;
        overflow: hidden;
        background: #000;
        color-scheme: dark;
      }

      body {
        font-size: initial;
      }

      #cast-loading-screen {
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: #000;
        opacity: 1;
      }

      #cast-loading-screen[hidden] {
        display: none;
      }

      #cast-loading-particles {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0.4;
        touch-action: none;
      }

      #cast-brightness-overlay {
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        pointer-events: none;
        background: #000;
        opacity: 0;
        transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1);
      }

      #cast-vignette-overlay {
        position: fixed;
        inset: 0;
        z-index: 2147483646;
        pointer-events: none;
        background:
          linear-gradient(
            to right,
            #000,
            transparent var(--vignette-size, 0px)
          ),
          linear-gradient(to left, #000, transparent var(--vignette-size, 0px)),
          linear-gradient(
            to bottom,
            #000,
            transparent var(--vignette-size, 0px)
          ),
          linear-gradient(to top, #000, transparent var(--vignette-size, 0px));
      }

      @media (prefers-reduced-motion: reduce) {
        #cast-brightness-overlay {
          transition-duration: 0ms;
        }
      }
    </style>
    <%= renderTemplate("../../../src/html/_style_base.html.template") %>
  </head>
  <body>
    <div
      id="cast-loading-screen"
      role="status"
      aria-label="Loading Home Assistant"
    >
      <canvas id="cast-loading-particles" aria-hidden="true"></canvas>
    </div>
    <div id="cast-vignette-overlay" aria-hidden="true"></div>
    <div id="cast-brightness-overlay" aria-hidden="true"></div>
    <script>
      <%= renderTemplate("./_loading_particles.js") %>
      <%= renderTemplate("./_loading_screen.js") %>
    </script>
    <script>
      // Give the inline loading screen a paint before parsing the SDK and app.
      window.blueHouseCastLoadingScreen.ready.then(() => requestAnimationFrame(() => requestAnimationFrame(() => {
        const sdk = document.createElement("script");
        sdk.src = "//www.gstatic.com/cast/sdk/libs/caf_receiver/v3/cast_receiver_framework.js";
        sdk.onload = () => {
          <% for (const entry of latestEntryJS) { %>
          {
            const app = document.createElement("script");
            app.type = "module";
            app.src = "<%= entry %>";
            document.body.appendChild(app);
          }
          <% } %>
        };
        document.body.appendChild(sdk);
      })));
    </script>
  </body>
</html>
